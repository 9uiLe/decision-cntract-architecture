+    private suspend fun verifyQualification(
+        admission: ReservationAdmission.Qualified,
+        certificate: EligibilityCertificate?,
+    ): Denial? {
+        if (certificate == null || !certificate.matches(admission)) return Denial.WrongTarget
+        val askedAt = clock.now()
+        val unknown = Reverification.Failed(ReverificationFailure.Unconfirmed)
+        val result = observe<Reverification>(unknown) { eligibility.verify(listOf(certificate)) }
+        return when (result) {
+            is Reverification.Failed -> when (result.reason) {
+                ReverificationFailure.NotHeld -> Denial.QualificationNotHeld
+                ReverificationFailure.Expired -> Denial.QualificationExpired
+                ReverificationFailure.Unconfirmed -> Denial.QualificationUnconfirmed
+                ReverificationFailure.TargetMismatch -> Denial.WrongTarget
+            }
+            is Reverification.Verified -> {
+                val answeredAt = clock.now()
+                val refreshed = result.certificates.singleOrNull() ?: return Denial.QualificationUnconfirmed
+                if (!refreshed.matches(admission)) return Denial.WrongTarget
+                if (refreshed.checkedAt !in askedAt..answeredAt) return Denial.QualificationUnconfirmed
+                windowDenial(windowAt(admission.start, refreshed.checkedAt))
+            }
+        }
+    }
