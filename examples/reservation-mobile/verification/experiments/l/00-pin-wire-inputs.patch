--- /dev/null
+++ b/adapter-simulator/src/commonTest/kotlin/example/adapter/simulator/QualificationWireExperimentTest.kt
@@ -0,0 +1,34 @@
+package example.adapter.simulator
+
+import example.eligibility.core.QualificationKind
+import example.eligibility.core.QualificationObservation
+import example.kernel.EpochMillis
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class QualificationWireExperimentTest {
+    private val pottery = QualificationKind("pottery-advanced")
+
+    @Test
+    fun `資格コードと期限を変更しても同じ資格観測に変換する`() {
+        assertEquals(
+            QualificationObservation.Held(EpochMillis(1830340800000L)),
+            QualificationDecoder.decode("held=true&code=POTTERY-ADV&valid_until=2028-01-01T12:00:00Z", pottery),
+        )
+    }
+
+    @Test
+    fun `旧版と新版を取り違えた入力や未知の資格と不正な期限から有効とは判断しない`() {
+        listOf(
+            "held=true&qualification_code=workshop.pottery.level2&expires_at=2028-01-01T12:00:00Z",
+            "held=true&code=OTHER&valid_until=2028-01-01T12:00:00Z",
+            "held=true&code=POTTERY-ADV&valid_until=tomorrow",
+        ).forEach { input ->
+            assertEquals(QualificationObservation.Unavailable, QualificationDecoder.decode(input, pottery))
+        }
+        assertEquals(
+            QualificationObservation.NotHeld,
+            QualificationDecoder.decode("held=false", pottery),
+        )
+    }
+}
