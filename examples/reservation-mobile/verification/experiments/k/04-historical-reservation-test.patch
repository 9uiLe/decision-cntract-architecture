+package example.reservation.core
+
+import example.adapter.simulator.QualificationHolding
+import example.adapter.simulator.createSimulator
+import example.checkin.core.CheckInAttemptId
+import example.checkin.core.CheckInKey
+import example.checkin.core.ParticipantCheckIn
+import example.checkin.core.createCheckInCore
+import example.eligibility.core.QualificationKind
+import example.eligibility.core.createEligibilityCore
+import example.kernel.Clock
+import example.kernel.EpochMillis
+import example.kernel.ParticipantId
+import example.kernel.SessionId
+import example.reservation.ui.CheckInView
+import example.reservation.ui.ReservationCard
+import example.reservation.ui.projectReservation
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+import kotlin.time.Duration.Companion.seconds
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class RequiredQualificationExperimentTest {
+    @Test
+    fun `新規は基礎安全講習を要し、導入前の予約は履歴から読み出して受付できる`() = runTest {
+        val start = EpochMillis(1_800_000_000_000L)
+        var now = EpochMillis(start.value - 72 * 3_600_000)
+        val clock = Clock { now }
+        val safety = QualificationKind("basic-safety", "基礎安全講習修了")
+        val participant = ParticipantId("a")
+        val session = SessionId("beginner")
+        val workshop = Workshop(session, "初心者向け講習", start, 4, NewBookingRequirement(safety))
+        val simulator = createSimulator(mapOf(session to 4), listOf(QualificationHolding(participant, safety, start)))
+        val eligibility = createEligibilityCore(simulator.eligibility, clock, this, 2.seconds)
+        val previousId = assertIs<CreateObservation.Created>(
+            simulator.reservation.create(RequestId("before-policy"), session, listOf(participant)),
+        ).reservation
+        val previousBooking = Booking(workshop, listOf(participant), BookedBasis.WithoutQualification)
+        val previousRecord = ReservationRecord.Reserved(
+            previousId,
+            previousBooking,
+            CancelTicket(previousId),
+            lastCancelFailure = null,
+            admissions = listOf(ReservationAdmission.Open(previousId, participant, session, start)),
+        )
+        val reservation = ReservationCore(
+            Catalog(listOf(workshop), listOf(Participant(participant, "佐藤"))),
+            simulator.reservation,
+            eligibility,
+            clock,
+            { RequestId("after-policy") },
+            this,
+            2.seconds,
+            initialReservations = listOf(previousRecord),
+        )
+        val checkIn = createCheckInCore(reservation, simulator.checkIn, clock, this, { CheckInAttemptId("a") }, 2.seconds)
+
+        reservation.selectWorkshop(session)
+        reservation.toggleParticipant(participant)
+        assertIs<ConfirmOutcome.EligibilityNotMet>(reservation.confirmQualified())
+        assertEquals(1, simulator.controls.observations.value.createRequests)
+
+        reservation.requestEligibility()
+        runCurrent()
+        val verified = assertIs<ConfirmOutcome.Confirmed>(reservation.confirmQualified())
+        assertEquals(Acceptance.Accepted, reservation.submit(verified.draft))
+        runCurrent()
+        val history = reservation.snapshot.value.reservations
+        assertEquals(BookedBasis.WithoutQualification, history.first().booking.basis)
+        val historicalCard = assertIs<ReservationCard.Reserved>(
+            projectReservation(history.first(), null, mapOf(participant to "佐藤"), checkIn.snapshot.value),
+        )
+        assertEquals(previousId.value, historicalCard.reservationId)
+        assertEquals(CheckInView.NotCheckedIn, historicalCard.participants.single().view)
+        assertEquals(BookedBasis.WithQualification(safety), history.last().booking.basis)
+        assertEquals(2, simulator.controls.observations.value.activeReservations)
+
+        now = EpochMillis(start.value - 20 * 60_000)
+        val before = simulator.controls.observations.value.qualificationRequests
+        val admission = assertIs<AdmissionLookup.Valid>(reservation.admission(previousId, participant)).admission.record
+        checkIn.checkIn(assertIs<ReservationAdmission.Open>(admission))
+        runCurrent()
+        assertEquals(ParticipantCheckIn.CheckedIn, checkIn.snapshot.value.entries[CheckInKey(previousId, participant)])
+        assertEquals(before, simulator.controls.observations.value.qualificationRequests)
+        assertEquals(1, simulator.controls.observations.value.checkInCreateRequests)
+        assertEquals(1, simulator.controls.observations.value.checkInRecords.single().records)
+    }
+}
