     fun cancel(ticket: CancelTicket): Acceptance = relay(core.cancel(ticket))
 
-    fun checkInParticipant(admission: ReservationAdmission): CheckInAcceptance = relayCheckIn(checkIn.checkIn(admission))
+    fun checkInParticipant(admission: ReservationAdmission) {
+        when (admission) {
+            is ReservationAdmission.Open -> relayCheckIn(checkIn.checkIn(admission))
+            is ReservationAdmission.Qualified -> {
+                val status = eligibility.status(admission.participant, admission.kind)
+                val outcome = (status as? EligibilityStatus.Settled)?.outcome
+                when (outcome) {
+                    is EligibilityOutcome.Eligible -> relayCheckIn(checkIn.checkIn(admission, outcome.certificate))
+                    null -> refreshCheckInQualification(admission, "資格を確認しています。確認後にもう一度受付をお試しください。")
+                    EligibilityOutcome.Unknown -> refreshCheckInQualification(admission, "資格を確認できませんでした。もう一度照会します。")
+                    EligibilityOutcome.NotHeld -> refreshCheckInQualification(admission, "来場受付に必要な資格がありません。もう一度照会します。")
+                    EligibilityOutcome.Expired -> refreshCheckInQualification(admission, "確認済みの資格の期限が切れています。もう一度照会します。")
+                }
+            }
+        }
+    }
+
+    private fun refreshCheckInQualification(admission: ReservationAdmission.Qualified, message: String) {
+        eligibility.request(admission.participant, admission.kind)
+        notify(message)
+    }
 
     fun lookUpCheckIn(ticket: CheckInStatusTicket): CheckInAcceptance = relayCheckIn(checkIn.checkStatus(ticket))
