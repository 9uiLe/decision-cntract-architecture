{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dca",
  "version": "0.1.0",
  "description": "既存プロジェクトの一つの業務フローを、判断契約(DCA)の観点で調査・合意・段階移行するための Skill 群",
  "author": {
    "name": "9uiLe",
    "url": "https://github.com/9uiLe"
  },
  "homepage": "https://github.com/9uiLe/decision-cntract-architecture/tree/main/plugins/dca",
  "repository": "https://github.com/9uiLe/decision-cntract-architecture",
  "keywords": [
    "dca",
    "decision-contract",
    "kotlin",
    "kmp",
    "refactoring"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "DCA",
        "shortDescription": "業務フローを判断契約で調査し、段階移行する",
        "longDescription": "既存プロジェクトの一つの業務フローについて、判断と保証の所在の整理、問題の調査、未決事項の合意、段階移行、Lint の提案を行う。調査と合意の記録は対象リポジトリの外に保存する。",
        "developerName": "9uiLe",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "DCA を既存の業務フローに導入したい。どの Skill から始めればよいか案内して"
        ]
      }
    }
  }
}
